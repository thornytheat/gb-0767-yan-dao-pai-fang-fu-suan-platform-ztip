<div class="scroll"><table><thead><tr><th>小时</th><th>复算</th><th>报送</th><th>差值</th><th>裁决</th></tr></thead><tbody>{% for h in result.reports.rows %}<tr><td>{{ h.local }}</td><td>{{ h.mg_nm3 or '—' }}</td><td title="{{ h.reports|map(attribute='line')|join(', ') }}">{{ h.reported_mg_nm3 or '—' }}</td><td>{{ h.difference_mg_nm3 or '—' }}</td><td><span class="tag {{ h.code }}">{{ labels[h.code] }}</span></td></tr>{% endfor %}</tbody></table></div>
